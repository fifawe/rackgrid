# Database
DB_HOST=mariadb
DB_PORT=3306
DB_USER=asset_inventory
DB_PASSWORD=change_me
DB_NAME=asset_inventory

# App
APP_ENV=development
# IANA timezone (e.g. Africa/Cairo, Asia/Riyadh) - drives the
# scheduler's cron interpretation. Defaults to UTC if unset.
TZ=UTC
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
COLLECTOR_API_KEY=change_me_collector_api_key
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost

# Scheduler
SCHEDULER_ENABLED=true
DEFAULT_COLLECTOR_CRON=0 2 * * *

# Asset lifecycle thresholds (days)
ACTIVE_THRESHOLD_DAYS=7
OFFLINE_THRESHOLD_DAYS=30
