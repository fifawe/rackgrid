# Copy this file to deployment/.env and fill in real values before
# running `docker compose up`.

APP_ENV=production
LOG_LEVEL=INFO

# IANA timezone name applied to every container (all default to UTC
# otherwise). This is what DEFAULT_COLLECTOR_CRON below is interpreted
# in - e.g. with TZ=Africa/Cairo, "0 2 * * *" means 2am Cairo time, not
# 2am UTC. Examples: Africa/Cairo, Asia/Riyadh, UTC.
TZ=UTC

# --- Database -----------------------------------------------------------
DB_NAME=asset_inventory
DB_USER=asset_inventory
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_db_root_password
DB_EXPOSED_PORT=3306

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret the Ansible collector presents when submitting discovery
# payloads - generate the same way as SECRET_KEY.
COLLECTOR_API_KEY=change_me_collector_api_key

CORS_ORIGINS=http://localhost

# --- Scheduler ------------------------------------------------------------
SCHEDULER_ENABLED=true
DEFAULT_COLLECTOR_CRON=0 2 * * *

# --- Asset lifecycle thresholds (days) ------------------------------------
ACTIVE_THRESHOLD_DAYS=7
OFFLINE_THRESHOLD_DAYS=30

# --- Exposed ports (host side) --------------------------------------------
BACKEND_EXPOSED_PORT=8000
FRONTEND_EXPOSED_PORT=80
COLLECTOR_EXPOSED_PORT=9100
